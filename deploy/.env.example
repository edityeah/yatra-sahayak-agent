# Copy to deploy/.env and fill in. Never commit the real .env.

# --- Cloudflare tunnel ---
# Zero Trust → Networks → Tunnels → your tunnel → copy the connector token.
TUNNEL_TOKEN=

# --- API auth ---
INTERNAL_API_KEY=            # browser-shipped key (baked into the UI at build)
ADMIN_API_KEY=               # distinct! gates officer/PII endpoints (openssl rand -base64 32)
OFFICER_IDS=                 # comma-separated SwiftChat user ids allowed into the officer bot

# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_MAIN_MODEL=gpt-4o-mini

# --- Supabase Postgres (empty ⇒ in-memory, non-durable) ---
DATABASE_URL=                # pooled 6543, ?pgbouncer=true
DIRECT_URL=                  # direct 5432 (migrations)

# --- SwiftChat inbound webhook (if pointing the bot here) ---
SWIFTCHAT_WEBHOOK_SECRET=

# --- Voice (only if you also run the LiveKit worker; not required for web) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_API_HOST=https://yatri.adityeah.ai
